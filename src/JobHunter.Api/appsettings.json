{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [{ "Name": "Console" }]
  },
  "Database": {
    "ConnectionString": "",
    "ApplyMigrationsOnStartup": false
  },
  "Auth": {
    "SessionCookieName": "__Host-jh_session",
    "CsrfCookieName": "jh_csrf",
    "SecureCookies": true,
    "SessionAbsoluteDays": 30,
    "SessionIdleDays": 7,
    "ResetTokenMinutes": 30,
    "LogPasswordResetLinks": false,
    "WebBaseUrl": ""
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowMinutes": 15 },
    "Import": { "PermitLimit": 60, "WindowMinutes": 60 },
    "Ai": { "PermitLimit": 30, "WindowMinutes": 60 }
  },
  "FollowUps": {
    "AfterApplyDays": 7
  },
  "Workers": {
    "Enabled": true
  },
  "Ai": {
    "ApiKey": "",
    "Model": "claude-opus-5-5"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*"
}
